spring.application.name=smartfishingd

server.port=${PORT:8080}
spring.datasource.url=jdbc:sqlserver://SEU_SERVIDOR.mssql.somee.com;databaseName=SEU_BANCO;TrustServerCertificate=True
spring.datasource.username=SEU_USUARIO_DO_BANCO
spring.datasource.password=SUA_SENHA_DO_BANCO
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.jpa.database-platform=org.hibernate.dialect.SQLServerDialect
spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.show_sql=true
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

app.jwt.secret=TROQUE_POR_UMA_CHAVE_ALEATORIA_LONGA
app.jwt.expiration-ms=86400000

spring.mail.host=smtp.mailersend.net
spring.mail.port=587
spring.mail.username=SEU_USUARIO_MAILERSEND
spring.mail.password=SUA_SENHA_MAILERSEND
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

app.frontend.reset-password-url=http://localhost:5173/redefinir-senha
app.jwt.reset-password-expiration-minutes=60
